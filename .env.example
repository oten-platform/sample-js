# Oten IDP Configuration
# Copy this file to .env and fill in your actual values

# Required: Oten IDP authority URL
VITE_OTEN_IDP_AUTH_DOMAIN=https://account.oten.com/

# Required: Your application's client ID from Oten IDP dashboard
# Example: abc123xyz456...
VITE_OTEN_IDP_CLIENT_ID=your_client_id_here
